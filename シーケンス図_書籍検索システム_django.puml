@startuml ログアウトする

actor ユーザー as U
boundary "serch.html" as SH
control "logout_view\n/logout" as LV
control "serch_view\n/" as SV

U -> SH : ログアウトボタンを押す
SH -> SH : 確認アラート表示
alt 確認
  U -> SH : 確認ボタンを押す
  SH -> LV : GET
  LV -> LV : logout
  LV -> SV : リダイレクト
  SH <-- SV : 表示する
else キャンセル
  U -> SH : キャンセルを押す
  SH -> SH : アラートを閉じる
end



@enduml
@startuml 従業員を登録する

actor ユーザー as U
boundary "employee.html" as EH
control "enployee_view\n/" as EV
boundary "employeesub.html" as SH
control "employeesub_view\n/" as SV
boundary "employeecomplate.html" as CH
control "employeecomplate_view\n/" as CV
entity "employee" as E

U -> EH : 追加ボタンを押す
EH -> SV : GET
SV -> SH :表示する

alt 戻るボタンを押した場合
U -> SH :戻るボタンを押す
SH -> SV :GET
SV -> EH :表示する

else 登録ボタンを押した場合
U -> SH :登録ボタンを押す
SH -> SV : 入力された内容を\n確認する

alt 入力が正常だった場合
SV -> E :入力された内容を\nデータベースにPOSTする
E -> CV : 取得
SV -> CV : リダイレクト
CV -> CH : 表示する
U -> CH :戻るボタンを押す
CH -> CV : GET
CV -> EH :表示する

else 入力のいずれかが不正だった場合
SV -> EH : エラーメッセージを表示

end
end


@enduml
@startuml 従業員を削除する

actor ユーザー as U
boundary "employee.html" as EH
control "enployee_view\n/" as EV
boundary "deleteconfirm.html" as DH
control "deleteconfirm_view\n/" as DV
entity "employee" as E
boundary "delcomplate.html" as DC
control "delcomplate_view\n/" as CV 

U -> EH : 削除ボタンを押す
EH -> DV : GET
DV -> DH : 表示する
alt 確定ボタンを押した場合
U -> DH : 確定ボタンを押す
DH -> DV : GET
DV -> E : 該当の従業員の\n情報を削除する(POST)
DV -> DC : 表示する
U -> DC : 戻るボタン押す
DC -> CV : GET
CV -> EH : 表示する
else キャンセルボタンを押した場合
U -> DH :キャンセルボタンを押す
DH -> DV :GET
DV -> EH : 表示する
end


@enduml
